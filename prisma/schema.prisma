generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  KASSIER
  SCHRIFTFUEHRER
  VORSTAND
  MITGLIED
}

enum MemberStatus {
  AKTIV
  PASSIV
  EHRENMITGLIED
  AUSGETRETEN
}

enum TxType {
  EINNAHME
  AUSGABE
}

enum LicenseStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  EXPIRED
}

enum TokenPurpose {
  PASSWORD_SETUP
  PASSWORD_RESET
  MEMBER_ACTIVATION
}

enum MfaPolicy {
  OPTIONAL
  BOARD
  ALL
}

/// How an issuer handles VAT on its invoices
enum TaxMode {
  KLEINUNTERNEHMER // § 6 Abs. 1 Z 27 UStG – no VAT, mandatory note
  STEUERPFLICHTIG // VAT per line (20/13/10/0 %)
  NICHT_STEUERBAR // e.g. a non-profit club outside its business sphere – no VAT, note
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum InvoiceKind {
  INVOICE
  CANCELLATION // Stornorechnung: negative amounts, references the cancelled invoice
}

enum Module {
  MITGLIEDER
  FINANZEN
  EVENTS
  NOTIZEN
  DOKUMENTE
  KOMMUNIKATION
}

model Club {
  id               String    @id @default(cuid())
  name             String    @unique
  slug             String    @unique
  email            String?
  address          String?
  iban             String?
  bic              String?
  bankName         String?
  vatId            String? /// UID-Nummer, if the club has one
  taxMode          TaxMode   @default(NICHT_STEUERBAR)
  invoicePrefix    String    @default("RE")
  paymentTermsDays Int       @default(14)
  invoiceFooter    String?
  logoPath         String?
  /// subdomain used before the last change; redirects until slugChangedAt + 90 days
  previousSlug     String?   @unique
  slugChangedAt    DateTime?
  // White-label branding
  /// who in this club must use a second factor
  mfaPolicy        MfaPolicy @default(OPTIONAL)
  primaryColor     String    @default("#2e5a44")
  accentColor      String    @default("#a87a1f")
  fontKey          String    @default("schibsted")
  logoDarkPath     String?
  faviconPath      String?
  loginTitle       String?
  loginText        String?
  loginImagePath   String?
  emailSenderName  String?
  emailFooter      String?
  openingBalance   Decimal   @default(0) @db.Decimal(12, 2)
  calendarToken    String    @unique @default(uuid())
  modules          Module[]  @default([MITGLIEDER, FINANZEN, EVENTS, NOTIZEN, DOKUMENTE, KOMMUNIKATION])
  createdAt        DateTime  @default(now())

  users            User[]
  members          Member[]
  transactions     Transaction[]
  events           Event[]
  notes            Note[]
  documents        Document[]
  invoices         Invoice[]       @relation("IssuedBy")
  receivedInvoices Invoice[]       @relation("ReceivedBy")
  contacts         Contact[]
  templates        EmailTemplate[]
  licenses         License[]
  activities       Activity[]
  emails           EmailLog[]
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String?
  role               Role      @default(MITGLIED)
  isPlatformAdmin    Boolean   @default(false)
  emailNotifications Boolean   @default(true)
  clubId             String?
  club               Club?     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member             Member?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  // Multi-factor authentication
  totpSecretEnc      String? /// AES-256-GCM encrypted base32 secret (set while enrolling, active once totpEnabledAt is set)
  totpEnabledAt      DateTime?
  totpLastStep       Int? /// last accepted 30 s step – blocks replay of a code
  recoveryHashes     String[]  @default([])

  sessions   Session[]
  passkeys   Passkey[]
  tokens     Token[]
  documents  Document[]
  activities Activity[]

  @@index([clubId])
}

model Session {
  id                 String   @id
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// set when a platform admin acts inside a club ("Als Verein einloggen")
  impersonatedClubId String?
  /// password accepted, second factor still outstanding
  mfaPending         Boolean  @default(false)
  mfaAttempts        Int      @default(0)
  /// WebAuthn challenge of the ongoing passkey ceremony
  webauthnChallenge  String?
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  @@index([userId])
}

model Token {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  purpose   TokenPurpose
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
}

model Member {
  id          String       @id @default(cuid())
  clubId      String
  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId      String?      @unique
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName   String
  lastName    String
  email       String
  phone       String?
  birthday    DateTime?    @db.Date
  street      String?
  zip         String?
  city        String?
  joinedAt    DateTime?    @db.Date
  leftAt      DateTime?    @db.Date
  status      MemberStatus @default(AKTIV)
  function    String?
  fee         Decimal      @default(0) @db.Decimal(10, 2)
  feePaidYear Int?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  transactions Transaction[]
  invoices     Invoice[]

  @@unique([clubId, email])
  @@index([clubId, lastName])
}

model Transaction {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  type        TxType
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @db.Date
  description String?
  memberId    String?
  member      Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// set for the automatic fee booking of a member for that year
  feeYear     Int?
  eventId     String?  @unique
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  /// booking created when an invoice of the club was marked as paid
  invoiceId   String?  @unique
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([memberId, feeYear])
  @@index([clubId, date])
}

model Event {
  id          String       @id @default(cuid())
  clubId      String
  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  cost        Decimal?     @db.Decimal(12, 2)
  public      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  transaction Transaction?

  @@index([clubId, startsAt])
}

model Note {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title     String
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id               String   @id @default(cuid())
  clubId           String
  club             Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  uploadedById     String?
  uploadedBy       User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  storageName      String   @unique
  originalName     String
  mimeType         String
  size             Int
  description      String?
  visibleToMembers Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model EmailTemplate {
  id      String @id @default(cuid())
  clubId  String
  club    Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name    String
  subject String
  body    String
}

model EmailLog {
  id         String   @id @default(cuid())
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  subject    String
  recipients Int
  failed     Int      @default(0)
  sentAt     DateTime @default(now())
}

model LicensePlan {
  id             String           @id @default(cuid())
  name           String           @unique
  description    String?
  maxUsers       Int?
  maxMembers     Int?
  durationMonths Int?             @default(12)
  modules        Module[]         @default([MITGLIEDER, FINANZEN, EVENTS, NOTIZEN, DOKUMENTE, KOMMUNIKATION])
  active         Boolean          @default(true)
  // public price list on the landing page
  priceCents     Int? /// per year, gross; null = "auf Anfrage"
  publicListed   Boolean          @default(false)
  highlighted    Boolean          @default(false)
  sortOrder      Int              @default(0)
  requests       ContactRequest[]
  createdAt      DateTime         @default(now())
  licenses       License[]
}

model License {
  id            String         @id @default(cuid())
  key           String         @unique
  name          String
  planId        String?
  plan          LicensePlan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  /// days-before-expiry reminders already sent for the current validUntil
  remindersSent Int[]          @default([])
  invoices      Invoice[]
  events        LicenseEvent[]
  status        LicenseStatus  @default(ACTIVE)
  maxUsers      Int?
  maxMembers    Int?
  validFrom     DateTime?      @db.Date
  validUntil    DateTime?      @db.Date
  notes         String?
  clubId        String?
  club          Club?          @relation(fields: [clubId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model LicenseEvent {
  id        String   @id @default(cuid())
  licenseId String
  license   License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  userId    String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([licenseId, createdAt])
}

model ImpersonationTicket {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  adminId   String
  clubId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  clubId    String?
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
}

model Passkey {
  id         String    @id /// credential ID (base64url)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey  Bytes
  counter    Int       @default(0)
  transports String[]  @default([])
  rpId       String /// host the passkey was created on (club subdomain or admin host)
  name       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/**
 * Operator details for imprint, privacy policy and terms – edited in the platform admin panel.
 */
model PlatformSettings {
  id               String   @id @default("default")
  operatorName     String?
  legalForm        String? /// e.g. Einzelunternehmen, GmbH
  street           String?
  zipCity          String?
  country          String?  @default("Österreich")
  email            String?
  phone            String?
  vatId            String? /// UID-Nummer
  companyRegister  String? /// Firmenbuchnummer und -gericht
  businessPurpose  String? /// Unternehmensgegenstand
  authority        String? /// Gewerbebehörde
  chamber          String? /// Kammer / Berufsrecht
  representative   String? /// Geschäftsführung / vertretungsbefugt
  hostingProvider  String? /// name and location of the server provider
  mailProvider     String?
  // invoicing of the platform
  taxMode          TaxMode  @default(KLEINUNTERNEHMER)
  invoicePrefix    String   @default("RE")
  paymentTermsDays Int      @default(14)
  iban             String?
  bic              String?
  bankName         String?
  invoiceFooter    String?
  contactEmail     String? /// receives contact requests
  updatedAt        DateTime @updatedAt
}

model ContactRequest {
  id        String       @id @default(cuid())
  clubName  String
  name      String
  email     String
  phone     String?
  members   Int?
  message   String?
  planId    String?
  plan      LicensePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  handledAt DateTime?
  createdAt DateTime     @default(now())
}

/**
 * Address book of a club for invoices to third parties (sponsors, municipalities, companies).
 */
model Contact {
  id        String    @id @default(cuid())
  clubId    String
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  address   String? /// multi-line postal address
  email     String?
  vatId     String?
  notes     String?
  createdAt DateTime  @default(now())
  invoices  Invoice[]

  @@index([clubId, name])
}

/// Invoice of the platform (issuerClubId = null) or of a club. Issued invoices are immutable:
/// number, issuer and recipient are frozen; corrections only via a cancellation invoice.
model Invoice {
  id                 String        @id @default(cuid())
  issuerClubId       String?
  issuerClub         Club?         @relation("IssuedBy", fields: [issuerClubId], references: [id], onDelete: Cascade)
  kind               InvoiceKind   @default(INVOICE)
  status             InvoiceStatus @default(DRAFT)
  number             String? /// assigned when issued
  issueDate          DateTime?     @db.Date
  servicePeriod      String? /// Leistungsdatum/-zeitraum as text
  dueDate            DateTime?     @db.Date
  taxMode            TaxMode
  /// frozen at issue: issuer name, address, UID, bank, register data
  issuerSnapshot     Json?
  recipientClubId    String?
  recipientClub      Club?         @relation("ReceivedBy", fields: [recipientClubId], references: [id], onDelete: SetNull)
  recipientContactId String?
  recipientContact   Contact?      @relation(fields: [recipientContactId], references: [id], onDelete: SetNull)
  recipientMemberId  String?
  recipientMember    Member?       @relation(fields: [recipientMemberId], references: [id], onDelete: SetNull)
  recipientName      String
  recipientAddress   String?
  recipientEmail     String?
  recipientVatId     String?
  intro              String?
  notes              String?
  netCents           Int           @default(0)
  taxCents           Int           @default(0)
  grossCents         Int           @default(0)
  licenseId          String?
  license            License?      @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  /// end of the license period this invoice bills (platform subscription invoices)
  licensePeriodEnd   DateTime?     @db.Date
  /// membership fee year this invoice demands (Soll-Rechnung of a club to a member)
  feeYear            Int?
  cancelsId          String?       @unique
  cancels            Invoice?      @relation("Cancellation", fields: [cancelsId], references: [id], onDelete: SetNull)
  cancelledBy        Invoice?      @relation("Cancellation")
  sentAt             DateTime?
  remindedAt         DateTime?
  paidAt             DateTime?     @db.Date
  booking            Transaction?
  items              InvoiceItem[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([issuerClubId, number])
  @@index([issuerClubId, status])
  @@index([recipientClubId])
  @@index([licenseId])
  @@index([recipientMemberId, feeYear])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Decimal @db.Decimal(10, 3)
  unit        String? /// Stück, Stunden, Pauschale …
  unitCents   Int /// net unit price in cents (negative on cancellations)
  taxRate     Int     @default(0)
}

/// Gap-free numbering per issuer and year ("platform" or the club id).
model InvoiceCounter {
  issuerKey String
  year      Int
  last      Int    @default(0)

  @@id([issuerKey, year])
}
