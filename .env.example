# Hauptdomain der Plattform. DNS: A-/AAAA-Eintrag für die Domain UND für *.<Domain> auf den Server.
#   <BASE_DOMAIN>          Startseite (Verein suchen)
#   admin.<BASE_DOMAIN>    Super-Admin-Panel
#   <verein>.<BASE_DOMAIN> je Verein, eigenes Erscheinungsbild
# Caddy holt die Zertifikate je Subdomain automatisch (Let's Encrypt), nur für bekannte Vereine.
BASE_DOMAIN=vereine.example.at

# Datenbank
POSTGRES_USER=verein
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=verein
# DATABASE_URL wird von docker-compose aus den POSTGRES_* Werten gebaut.
# Für lokale Entwicklung ohne Docker: DATABASE_URL=postgresql://verein:verein@localhost:5432/verein

# Standard-Plattform-Admin (wird beim Start angelegt bzw. aktualisiert)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_NAME=Plattform-Admin
DEFAULT_ADMIN_PASSWORD=bitte-aendern-mind-12-zeichen

# SMTP
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Vereinsplattform <noreply@example.com>"

# Ablage für Uploads
UPLOAD_DIR=/data/uploads

# Optional: Ablauf-Erinnerungen der Lizenzen abschalten
# LICENSE_REMINDERS=off
