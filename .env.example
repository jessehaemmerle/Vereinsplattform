# Öffentliche Adresse der App (für Links in E-Mails, iCal-Feeds)
APP_URL=http://localhost
# Domain für Caddy (localhost = selbstsigniertes Zertifikat, echte Domain = Let's Encrypt)
DOMAIN=localhost

# Datenbank
POSTGRES_USER=verein
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=verein
# DATABASE_URL wird von docker-compose aus den POSTGRES_* Werten gebaut.
# Für lokale Entwicklung ohne Docker: DATABASE_URL=postgresql://verein:verein@localhost:5432/verein

# Standard-Plattform-Admin (wird beim Start angelegt bzw. aktualisiert)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_NAME=Plattform-Admin
DEFAULT_ADMIN_PASSWORD=bitte-aendern-mind-12-zeichen

# SMTP
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Vereinsplattform <noreply@example.com>"

# Ablage für Uploads
UPLOAD_DIR=/data/uploads
